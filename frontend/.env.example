VITE_BASE_URL=/
VITE_APP_TITLE=yeRAG
VITE_APP_DESC=Knowledge base and memory assistant
VITE_ROUTER_HISTORY_MODE=history
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=local-icon

# Local backend defaults. Override them in a mode-specific .env file when deploying.
VITE_SERVICE_BASE_URL=http://localhost:8081/api/v1
VITE_OTHER_SERVICE_BASE_URL={"api":"http://localhost:8081/api/v1","ws":"ws://localhost:8081"}
VITE_SERVICE_SUCCESS_CODE=200
VITE_SERVICE_LOGOUT_CODES=401
VITE_SERVICE_MODAL_LOGOUT_CODES=
VITE_SERVICE_EXPIRED_TOKEN_CODES=
VITE_HTTP_PROXY=Y

VITE_AUTH_ROUTE_MODE=static
VITE_STATIC_SUPER_ROLE=ADMIN
VITE_ROUTE_HOME=chat
VITE_MENU_ICON=mdi:menu
VITE_SOURCE_MAP=N
VITE_WS_TIMEOUT=10000
